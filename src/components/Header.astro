---
import Logo from "../assets/logo-eg.svg";
---

<header class="barra">
  <a href={import.meta.env.BASE_URL} class="marca" aria-label="emigildev, ir al inicio">
    <Logo height={36} aria-hidden="true" />
  </a>

  <nav aria-label="Principal">
    <ul>
      <li><a href="#proyectos">Proyectos</a></li>
      <li><a href="#sobre-mi">Sobre mí</a></li>
      <li><a href="#contacto">Contacto</a></li>
    </ul>
  </nav>
</header>

<style>
  .barra {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    background-color: color-mix(in srgb, var(--color-fondo) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-borde);
  }

  .marca {
    display: flex;
  }

  ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--color-texto-suave);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--color-rosa);
  }

    /* En pantallas chicas (celulares) achicamos márgenes y separación */
  @media (max-width: 480px) {
    .barra {
      padding: 1rem;
    }
    ul {
      gap: 1rem;
    }
  }
</style>