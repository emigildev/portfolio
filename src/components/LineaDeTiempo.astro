---
import type { Etapa } from "../data/trayectoria";

interface Props {
  titulo: string;
  etapas: Etapa[];
}

const { titulo, etapas } = Astro.props;
---

<div class="columna">
  <h3>{titulo}</h3>

  <ol class="linea">
    {
      etapas.map((etapa) => (
        <li class="etapa">
          <span class="periodo">
            {etapa.periodo}
            {etapa.enCurso && <span class="en-curso">En curso</span>}
          </span>
          <h4>{etapa.titulo}</h4>
          <p class="lugar">{etapa.lugar}</p>
          {etapa.descripcion && <p class="descripcion">{etapa.descripcion}</p>}
        </li>
      ))
    }
  </ol>
</div>

<style>
  h3 {
    margin: 0 0 1.25rem;
    font-size: 1.1rem;
    color: var(--color-texto);
  }

  /* La línea vertical: un borde a la izquierda de la lista */
  .linea {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
    border-left: 2px solid var(--color-borde);
  }

  .etapa {
    position: relative;
    padding-bottom: 1.75rem;
  }

  .etapa:last-child {
    padding-bottom: 0;
  }

  /* El punto de cada etapa, dibujado con CSS sobre la línea */
  .etapa::before {
    content: "";
    position: absolute;
    left: calc(-1.5rem - 7px);
    top: 0.3rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--degradado);
  }

  .periodo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-rosa);
  }

  .en-curso {
    font-size: 0.7rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-rosa);
  }

  h4 {
    margin: 0.3rem 0 0.2rem;
    font-size: 1rem;
    color: var(--color-texto);
  }

  p {
    margin: 0;
    color: var(--color-texto-suave);
  }

  .lugar {
    font-size: 0.9rem;
  }

  .descripcion {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }
</style>