---
const { titulo, descripcion, tecnologias } = Astro.props;
---

<article class="tarjeta">
  <h3>{titulo}</h3>
  <p>{descripcion}</p>
  <p class="tech"><strong>Tecnologías:</strong> {tecnologias}</p>
</article>

<style>
  .tarjeta {
    border: 1px solid var(--color-borde);
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 1rem;
    background-color: var(--color-superficie);
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .tarjeta:hover {
    transform: translateY(-5px);
    border-color: var(--color-violeta);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-violeta) 25%, transparent);
  }
  h3 {
    margin-top: 0;
    color: var(--color-texto);
  }
  p {
    color: var(--color-texto-suave);
  }
  .tech {
    font-size: 0.9rem;
  }
  .tech strong {
    color: var(--color-rosa);
  }
</style>
