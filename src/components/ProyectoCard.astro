---
import type { Proyecto } from "../data/proyectos";

// Las props de la tarjeta son exactamente los campos de un Proyecto
type Props = Proyecto;

const { titulo, descripcion, tecnologias, estado, demo, codigo } = Astro.props;
---

<article class="tarjeta">
  <div class="encabezado">
    <h3>{titulo}</h3>
    {estado === "en-desarrollo" && <span class="estado">En desarrollo</span>}
  </div>

  <p>{descripcion}</p>

  <ul class="tecnologias" aria-label="Tecnologías">
    {tecnologias.map((tecnologia) => <li>{tecnologia}</li>)}
  </ul>

  {
    (demo || codigo) && (
      <div class="enlaces">
        {demo && <a href={demo} target="_blank" rel="noopener">Ver sitio</a>}
        {codigo && <a href={codigo} target="_blank" rel="noopener">Ver código</a>}
      </div>
    )
  }
</article>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-borde);
    padding: 1.5rem;
    border-radius: 8px;
    background-color: var(--color-superficie);
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .tarjeta:hover {
    transform: translateY(-5px);
    border-color: var(--color-violeta);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-violeta) 25%, transparent);
  }
  .encabezado {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  h3 {
    margin: 0;
    color: var(--color-texto);
  }
  .estado {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    color: var(--color-rosa);
    border: 1px solid var(--color-rosa);
  }
  p {
    color: var(--color-texto-suave);
  }
  .tecnologias {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tecnologias li {
    font-size: 0.8rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--color-texto);
    background-color: color-mix(in srgb, var(--color-violeta) 22%, transparent);
  }
  .enlaces {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }
  .enlaces a {
    color: var(--color-rosa);
    font-weight: 600;
    text-decoration: none;
  }
  .enlaces a:hover {
    text-decoration: underline;
  }
</style>
