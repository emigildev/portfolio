---
import Layout from "../layouts/Layout.astro";
import ProyectoCard from "../components/ProyectoCard.astro";
import { proyectos } from "../data/proyectos";
import SobreMi from "../components/SobreMi.astro";
import Contacto from "../components/Contacto.astro";
import Trayectoria from "../components/Trayectoria.astro";

---

<Layout
  title="Emi | Desarrolladora Web"
  description="Portfolio de Emi, desarrolladora web. Proyectos con React, TypeScript, Astro y Supabase: apps en tiempo real, PWAs y sitios web."
>
  <main class="contenedor">
    <header class="presentacion">
      <h1>Hola, soy <span class="destacado">Emi</span></h1>
      <h2>Desarrolladora Web</h2>
      <p>
        Te doy la bienvenida a mi portfolio
      </p>
    </header>

    <section class="seccion" id="proyectos">
      <h2>Mis Trabajos</h2>

      <div class="grilla-proyectos">
        {proyectos.map((proyecto) => <ProyectoCard {...proyecto} />)}
      </div>

    </section>
    <SobreMi />
    <Trayectoria />
    <Contacto />
  </main>
</Layout>

<style>
.contenedor {
  max-width: 800px;
  margin: 0 auto;
  padding: 2rem;
}
.presentacion {
  text-align: center;
  margin-top: 4rem;
  margin-bottom: 4rem;
}
h1 {
  font-size: 3rem;
  color: var(--color-texto);
  margin-bottom: 0.5rem;
}
/* Texto con degradé: el fondo se "recorta" con la forma de las letras */
.destacado {
  background: var(--degradado);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.presentacion h2 {
  font-size: 1.5rem;
  color: var(--color-texto-suave);
  font-weight: 400;
}
p {
  color: var(--color-texto-suave);
}

.proyectos {
  scroll-margin-top: 5rem; /* para que la barra fija no tape el título */
}
.proyectos h2 {
  color: var(--color-texto);
  border-bottom: 2px solid var(--color-borde);
  padding-bottom: 0.5rem;
  margin-bottom: 1.5rem;
}  .grilla-proyectos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
</style>
