---
import Layout from "../layouts/Layout.astro";
import ProyectoCard from "../components/ProyectoCard.astro";

---

<Layout title="Emi - Portfolio Web">
  <main class="contenedor">
    <header class="presentacion">
      <h1>Hola, soy <span class="destacado">Emi</span></h1>
      <h2>Desarrolladora Web y Diseñadora Multimedia</h2>
      <p>
        Te doy la bienvenida a mi portfolio
      </p>
    </header>

    <section class="proyectos" id="proyectos">
      <h2>Mis Trabajos</h2>

      <div class="grilla-proyectos">
        <ProyectoCard
          titulo="PWA Gestión de Vuelos"
          descripcion="Aplicación progresiva para administración de información de vuelos y asignación de agentes de aerolínea."
          tecnologias="React, Node.js"
        />

        <ProyectoCard
          titulo="Sitio Web VW Kombi"
          descripcion="Proyecto final de grado enfocado en el diseño e historia de la icónica Volkswagen Kombi."
          tecnologias="HTML, CSS, JavaScript"
        />

        <ProyectoCard
          titulo="Sistema Tikkunpsynova"
          descripcion="Aplicación web para gestión de turnos y facturación de un grupo de psicología."
          tecnologias="Web Development"
        />

        <ProyectoCard
          titulo="Pollería App"
          descripcion="Aplicación web para gestión de personal de una pollería."
          tecnologias="React, Node.js"
        />
      </div>
    </section>
  </main>
</Layout>

<style>
.contenedor {
  max-width: 800px;
  margin: 0 auto;
  padding: 2rem;
}
.presentacion {
  text-align: center;
  margin-top: 4rem;
  margin-bottom: 4rem;
}
h1 {
  font-size: 3rem;
  color: var(--color-texto);
  margin-bottom: 0.5rem;
}
/* Texto con degradé: el fondo se "recorta" con la forma de las letras */
.destacado {
  background: var(--degradado);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
h2 {
  font-size: 1.5rem;
  color: var(--color-texto-suave);
  font-weight: 400;
}
p {
  color: var(--color-texto-suave);
}

.proyectos {
  scroll-margin-top: 5rem; /* para que la barra fija no tape el título */
}
.proyectos h2 {
  color: var(--color-texto);
  border-bottom: 2px solid var(--color-borde);
  padding-bottom: 0.5rem;
  margin-bottom: 1.5rem;
}  .grilla-proyectos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
</style>
