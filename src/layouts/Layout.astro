---
import Header from "../components/Header.astro";

// Aquí recibimos el título que le pasamos desde index.astro
const { title } = Astro.props;

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>

<style is:global>
  /* Paleta de colores del sitio: si cambiás un color acá, cambia en todos lados */
  :root {
    --color-fondo: #0d1526;
    --color-superficie: #151f35;
    --color-borde: #26324d;
    --color-texto: #e2e8f0;
    --color-texto-suave: #94a3b8;
    --color-violeta: #7338e2;
    --color-rosa: #fd79c7;
    --degradado: linear-gradient(90deg, var(--color-violeta), var(--color-rosa));
  }

  /* Estos estilos se aplicarán a toda la página web */
  html {
    font-family: system-ui, sans-serif;
    background-color: var(--color-fondo);
    color: var(--color-texto);
    color-scheme: dark;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    padding: 0;
  }
  * {
    box-sizing: border-box; /* El truco del Box Model que vimos antes */
  }

    /* Estilo compartido por todas las secciones de la página */
  .seccion {
    margin-top: 5rem;
    scroll-margin-top: 5rem; /* para que la barra fija no tape el título */
  }
  .seccion > h2 {
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-texto);
    border-bottom: 2px solid var(--color-borde);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
  }
</style>